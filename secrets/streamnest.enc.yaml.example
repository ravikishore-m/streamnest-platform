# Copy to a temp file, fill values, encrypt with sops → secrets/streamnest.enc.yaml
# Never commit the plaintext copy.
#
# registry: NAS OCI robot (pull + push)
# argocd.adminPasswordMbcrypt: output of `htpasswd -nbBC 10 "" 'PASSWORD' | tr -d ':\n' | sed 's/$2y/$2a/'`
apiVersion: v1
kind: Opaque
metadata:
  name: streamnest-secrets-document
stringData:
  registryHost: "NAS_REGISTRY_HOST:5000"
  registryUsername: "streamnest-robot"
  registryPassword: "CHANGE_ME"
  argocdAdminPasswordMbcrypt: "CHANGE_ME_BCRYPT"
  # Optional GitHub Actions / deploy token (fine-scoped, rotatable)
  githubDeployToken: ""
